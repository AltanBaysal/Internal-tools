__pycache__/
*.pyc
.pytest_cache/
node_modules/

# The built frontend ships in the repo -- override the root-level `dist/` ignore. The notebook
# clones this repo and never builds, so the bundle travels with the source. Re-including the
# directory is what matters: git never opens an ignored one, so a rule about the files inside it
# would never be read.
!frontend/dist/
